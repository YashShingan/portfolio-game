{
  "name": "@yashshingan/portfolio-game",
  "version": "2.0.0",
  "description": "Interactive 2D top-down RPG portfolio website and retro game built with Next.js 16, Phaser 3, TypeScript, and Tailwind CSS.",
  "private": false,
  "author": "Yash Shingan (https://github.com/YashShingan)",
  "license": "MIT",
  "homepage": "https://yashshingan.github.io/portfolio-game/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yashshingan/portfolio-game.git"
  },
  "bugs": {
    "url": "https://github.com/YashShingan/portfolio-game/issues"
  },
  "keywords": [
    "portfolio",
    "portfolio-website",
    "interactive-portfolio",
    "developer-portfolio",
    "game-portfolio",
    "phaser",
    "phaser3",
    "game-development",
    "web-game",
    "2d-game",
    "rpg",
    "pixel-art",
    "retro-gaming",
    "chiptune",
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "web-audio-api",
    "server-sent-events"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./audio": {
      "types": "./dist/audio.d.ts",
      "import": "./dist/audio.mjs",
      "require": "./dist/audio.cjs"
    },
    "./controls": {
      "types": "./dist/controls.d.ts",
      "import": "./dist/controls.mjs",
      "require": "./dist/controls.cjs"
    },
    "./dialogue": {
      "types": "./dist/dialogue.d.ts",
      "import": "./dist/dialogue.mjs",
      "require": "./dist/dialogue.cjs"
    },
    "./arcade": {
      "types": "./dist/arcade.d.ts",
      "import": "./dist/arcade.mjs",
      "require": "./dist/arcade.cjs"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.mjs",
      "require": "./dist/engine.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "readme.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist/",
    "process-assets": "node scripts/process-fountain.js",
    "build:lib": "tsup && node scripts/copy-styles.mjs",
    "build:all": "npm run build && npm run build:lib",
    "prepack": "npm run build:lib"
  },
  "peerDependencies": {
    "phaser": ">=3.80.0",
    "react": ">=18.0.0 || >=19.0.0",
    "react-dom": ">=18.0.0 || >=19.0.0"
  },
  "peerDependenciesMeta": {
    "phaser": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.2",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "phaser": "3.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "sharp": "^0.34.3",
    "tailwindcss": "^4",
    "tsup": "^9.0.0",
    "typescript": "^5"
  }
}
